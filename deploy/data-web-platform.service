[Unit]
Description=Isolated LeTools Tianji Data Web Platform
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/projects/data-web-platform
Environment=DWP_PROJECT_ROOT=%h/projects/data-web-platform
Environment=DWP_LETOOLS_ROOT=%h/projects/letools-tianji
Environment=DWP_STATE_DIR=%h/projects/data-web-platform/.state
Environment=DWP_HOST=0.0.0.0
Environment=DWP_PORT=8095
Environment=DWP_VIEWER_PORT=3010
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=%h/projects/letools-tianji/.venv/bin/data-web-platform
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=25
Nice=10
CPUWeight=20
IOWeight=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
